# ==============================================================================
# JEEMU WEBAPP ENVIRONMENT VARIABLES
# Settings page: https://supabase.com/dashboard/project/quhpizadgfhhrdfompnm/settings/api-keys
# Copy this file to .env for local testing, or paste into Vercel Project Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (New Publishable & Secret API Keys Setup)
# ------------------------------------------------------------------------------

# Project URL:
SUPABASE_URL=https://quhpizadgfhhrdfompnm.supabase.co

# 1. NEW SUPABASE KEYS (Recommended)
# Publishable Key (starts with sb_publishable_ or pk_): Safe for client & browser
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret Key (starts with sb_secret_ or sk_): Server-side only (keep confidential!)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Frontend Vite variables (bundled into the client-side browser code)
VITE_SUPABASE_URL=https://quhpizadgfhhrdfompnm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ------------------------------------------------------------------------------
# LEGACY KEYS COMPATIBILITY (Optional fallback if still using legacy JWT keys)
# ------------------------------------------------------------------------------
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# LOCAL SERVER CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

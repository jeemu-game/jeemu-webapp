# ==============================================================================
# JEEMU WEBAPP ENVIRONMENT VARIABLES
# Supabase keys: Dashboard -> your project -> Project Settings -> API Keys
# Copy this file to .env for local testing, or paste into Vercel Project Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (New Publishable & Secret API Keys Setup)
# ------------------------------------------------------------------------------

# NOTE: when pasting values into Vercel use the copy icon (never triple-click a line) so no stray
# space or line break is saved. The backend also trims these, but keep them clean.
# There is no default project: a missing SUPABASE_URL fails loudly instead of using another project.

# Project URL (no trailing slash needed, but no spaces):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Secret Key (starts with sb_secret_): Server-side only (keep confidential!). Never prefix with VITE_.
# Create the tables first by running supabase/schema.sql in the Supabase SQL Editor.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ------------------------------------------------------------------------------
# LEGACY KEYS COMPATIBILITY (Optional fallback if still using legacy JWT keys)
# ------------------------------------------------------------------------------
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# LOCAL SERVER CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
PORT=3000
# ENV=production on any live deployment (hides /docs, enforces every security check). Vercel
# deployments are treated as production automatically; set ENV=development only for local work.
ENV=development

# ------------------------------------------------------------------------------
# STRIPE CONFIGURATION
# Get keys from: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------

# Secret key (server-side only — NEVER expose this to the browser)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Webhook signing secret — from Stripe CLI or Dashboard webhook settings
# Run locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Pre-configured Stripe Payment Link (fallback when Stripe SDK not configured)
# Optional. Leave empty unless it is a Payment Link from YOUR Stripe account (the old default belonged to another account).
STRIPE_PAYMENT_LINK=

# Early-bird deposit step (OFF by default). To enable: set DEPOSIT_ENABLED=true here AND VITE_DEPOSIT_ENABLED=true at build time.
# The checkout wording below is what customers see in Stripe; set the matching UI wording with VITE_DEPOSIT_AMOUNT / _COPY / _TERMS.
DEPOSIT_ENABLED=false
DEPOSIT_AMOUNT_CENTS=100
DEPOSIT_PRODUCT_NAME=Jeemu early-bird deposit
DEPOSIT_DESCRIPTION=Reserves your place for the Jeemu Kickstarter early bird.
# Production requires a webhook secret; unsigned webhooks are only ever accepted when ENV=test.

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION
# There is NO default password. Admin routes stay locked until you set these.
# Generate with:  openssl rand -hex 32   (a password you choose; it is not a Supabase login)
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-generate-with-openssl-rand-hex-32
# Comma-separated emails allowed to use a Supabase login on admin routes. Empty = nobody.
ADMIN_EMAILS=info@jeemu.fun

# Full public URL of the site (used for Stripe redirect URLs)
SITE_URL=https://jeemu.fun

# ------------------------------------------------------------------------------
# RESEND TRANSACTIONAL EMAIL API (RECOMMENDED — 3,000 Free Emails/Month)
# ------------------------------------------------------------------------------
# Create a free account at https://resend.com and generate an API key:
RESEND_API_KEY=re_your_resend_api_key_here
# Once your domain is added in Resend, send as your custom domain:
RESEND_FROM="Jeemu <info@jeemu.fun>"
# (Note: For immediate testing before domain DNS verification, you can set:)
# RESEND_FROM="Jeemu <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# HOSTINGER EMAIL SMTP CONFIGURATION (info@jeemu.fun Fallback)
# ------------------------------------------------------------------------------
# Hostinger SMTP Server details: https://support.hostinger.com/en/articles/1583569
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@jeemu.fun
# Password created for info@jeemu.fun in Hostinger Email control panel:
SMTP_PASS=your_hostinger_email_password_here
EMAIL_FROM="Jeemu <info@jeemu.fun>"

# Secret key used to sign 1-click unsubscribe links (prevents tampering). Generate: openssl rand -hex 32
# If unset, unsubscribe links are refused. Changing it invalidates links in emails already sent.
UNSUBSCRIBE_SECRET=change-me-generate-with-openssl-rand-hex-32

# ------------------------------------------------------------------------------
# GOOGLE SHEETS LIVE SYNC (AUTOMATIC WAITLIST & VIP SPREADSHEET)
# ------------------------------------------------------------------------------
# Deploy the provided script in scripts/google-apps-script.js to Google Sheets
# and paste your Web App deployment URL here:
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec

{
  "name": "jeemu-webapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "uv run ruff check backend api",
    "lint:fix": "uv run ruff check --fix backend api",
    "format": "uv run ruff format backend api",
    "format:check": "uv run ruff format --check backend api",
    "test:api": "uv run pytest backend/tests -v",
    "test:e2e": "node tests/e2e.test.js",
    "test:emails": "node tests/email_and_sheets.test.js && node tests/api_integration.test.js",
    "test": "npm run test:api",
    "sync:frontend": "node scripts/sync-frontend.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "lucide-react": "^1.48.0",
    "nodemailer": "^10.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^6.2.0"
  }
}
